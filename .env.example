# El detector NO opera: no tiene wallet ni claves de exchange. Todas las APIs son públicas.

# Telegram — solo envío (sin polling), reusa el bot de cryptobot sin conflicto
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

POLL_INTERVAL_SECONDS=180
RESUMEN_HOUR=9

# Filtro de mercado (DexScreener)
MIN_AGE_MIN=30
MAX_AGE_H=24
MIN_LIQ_USD=30000
MIN_VOL_H1_USD=50000
MIN_SELLS_H1=20

# Filtro de seguridad (RugCheck)
MIN_HOLDERS=300
MAX_TOP10_PCT=30
RUGCHECK_TTL_MIN=30

# Seguimiento: rug = la liquidez cae por debajo de esta fracción de la del aviso
RUG_LIQ_FRAC=0.2

# Descubrimiento (GeckoTerminal free: ~30 llamadas/min)
GT_NEW_POOLS_PAGES=3
GT_TRENDING_PAGES=2
